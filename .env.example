# SQL Server async connection string
# Format: mssql+aioodbc://<user>:<password>@<host>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost/appdb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# application
APP_ENV=development
